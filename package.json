{
    "private": true,
    "name": "photographers-panel",
    "scripts": {
        "build": "npm run build --workspaces",
        "prettier": "prettier --write '**/*.{ts,tsx,js,jsx,css,scss,html}'",
        "start": "NODE_ENV=development& node packages/server/dist/app.js",
        "watch": "concurrently \"npm:watch:*\"",
        "watch:utils": "npm run watch -w @pp/utils",
        "watch:api": "npm run watch -w @pp/api",
        "watch:server": "npm run start:dev -w @pp/server",
        "watch:panel": "npm run watch -w @pp/panel",
        "watch:gallery": "npm run watch -w @pp/gallery",
        "watch:site": "npm run watch -w @pp/site"
    },
    "browserslist": [
        "> 1%",
        "Chrome > 65"
    ],
    "workspaces": [
        "packages/*",
        "public_nodejs"
    ],
    "overrides": {
        "@types/react": "17.0.2",
        "@types/react-dom": "17.0.2"
    },
    "devDependencies": {
        "@phosphor-icons/react": "2.1.7",
        "concurrently": "^8.2.2"
    }
}
