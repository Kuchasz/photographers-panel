{
    "private": true,
    "name": "photographers-panel",
    "scripts": {
        "build": "pnpm run build --filter=*",
        "prettier": "prettier --write '**/*.{ts,tsx,js,jsx,css,scss,html}'",
        "start": "NODE_ENV=development& node packages/server/dist/app.js",
        "watch": "concurrently \"pnpm run watch:*\"",
        "watch:utils": "pnpm run watch --filter=@pp/utils",
        "watch:api": "pnpm run watch --filter=@pp/api",
        "watch:web": "pnpm run watch --filter=@pp/web",
        "lint": "pnpm run lint --filter=*",
        "lint:fix": "pnpm run lint:fix --filter=*",
        "test": "pnpm run test --filter=*",
        "type-check": "pnpm run type-check --filter=*",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx,json}\" --cache",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx,json}\" --cache"
    },
    "browserslist": [
        "> 1%",
        "Chrome > 65"
    ],
    "overrides": {
        "@types/react": "19.0.0",
        "@types/react-dom": "19.0.0",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "zustand": "5.0.3"
    },
    "devDependencies": {
        "@phosphor-icons/react": "2.1.7",
        "concurrently": "^8.2.2"
    },
    "peerDependencies": {},
    "packageManager": "pnpm@8.15.4",
    "pnpm": {
        "onlyBuiltDependencies": [
            "sharp"
        ]
    }
}