{
    "private": true,
    "name": "photographers-panel",
    "scripts": {
        "build": "pnpm run build --filter=*",
        "prettier": "prettier --write '**/*.{ts,tsx,js,jsx,css,scss,html}'",
        "start": "NODE_ENV=development& node packages/server/dist/app.js",
        "watch": "concurrently \"pnpm run watch:*\"",
        "watch:utils": "pnpm run watch --filter=@pp/utils",
        "watch:api": "pnpm run watch --filter=@pp/api",
        "watch:server": "pnpm run start:dev --filter=@pp/server",
        "watch:panel": "pnpm run watch --filter=@pp/panel",
        "watch:gallery": "pnpm run watch --filter=@pp/gallery",
        "watch:web": "pnpm run watch --filter=@pp/web"
    },
    "browserslist": [
        "> 1%",
        "Chrome > 65"
    ],
    "overrides": {
        "@types/react": "19.0.0",
        "@types/react-dom": "19.0.0",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "zustand": "5.0.3"
    },
    "devDependencies": {
        "@phosphor-icons/react": "2.1.7",
        "concurrently": "^8.2.2"
    },
    "peerDependencies": {},
    "packageManager": "pnpm@8.15.4",
    "pnpm": {
        "onlyBuiltDependencies": [
            "sharp"
        ]
    }
}